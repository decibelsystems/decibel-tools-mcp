# Decibel MCP Server Configuration
# Copy this file to .env and fill in the values you need. All entries are
# optional — the server boots without any of them and tools that depend on a
# given backend (Supabase / Postgres) cleanly no-op when the relevant vars are
# absent. .mcp.json forwards each var from your shell with `${VAR:-}` empty
# fallback, so you can also export these in ~/.bashrc / ~/.zshrc instead.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Environment (dev, staging, prod)
DECIBEL_ENV=dev

# Organization name
DECIBEL_ORG=your-org-name

# Root directory for global data files (optional). Default: ~/.decibel.
# Project-local data is always stored in each project's .decibel/ folder.
DECIBEL_MCP_ROOT=/path/to/your/global/decibel/data

# ---------------------------------------------------------------------------
# Supabase (optional — only required for voice inbox, agentic queue sync,
# and the SupabaseStore multi-tenant deployment path)
# ---------------------------------------------------------------------------
# Without these set, src/lib/supabase.ts isSupabaseConfigured() returns false
# and the affected tools surface a clear "Supabase is not configured" error
# instead of crashing the server.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Domain databases (optional — required only when their owning facades run)
# ---------------------------------------------------------------------------

# Senken (trading analysis facade) — Postgres connection string
SENKEN_DATABASE_URL=postgres://user:pass@host:5432/senken

# Mother (24/7 advisor facade) — Postgres connection string
MOTHER_DATABASE_URL=postgres://user:pass@host:5432/mother
